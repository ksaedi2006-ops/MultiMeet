ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional. Defaults to SQLite at backend/multimeet.db.
# DATABASE_URL=postgresql://user:password@localhost:5432/multimeet
# anthropic | simulated | auto (Claude when ANTHROPIC_API_KEY is set)
MULTIMEET_AGENTS=auto
# MULTIMEET_AGENT_MODEL=claude-opus-5-5
# MULTIMEET_MEDIATOR_MODEL=claude-opus-5-5
# Comma-separated allowed origins for the API
CORS_ORIGINS=*
